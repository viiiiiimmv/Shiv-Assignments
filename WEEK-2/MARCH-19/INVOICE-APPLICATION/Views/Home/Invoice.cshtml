@model INVOICE_APPLICATION.Models.Invoice

@{
    ViewData["Title"] = "Invoice";
}

<div class="row justify-content-center">
    <div class="col-xl-10">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
            <div>
                <h1 class="h2 mb-1">Invoice</h1>
                <p class="text-muted mb-0">Review the billing details for this order.</p>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="Order" class="btn btn-outline-secondary">Create Another Invoice</a>
                <a asp-action="Users" class="btn btn-primary">Customers</a>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-lg-8">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <h2 class="h5 card-title mb-3">Customer Details</h2>
                        <dl class="row mb-0">
                            <dt class="col-sm-3 text-muted">Name</dt>
                            <dd class="col-sm-9">@Model.Customer.Name</dd>

                            <dt class="col-sm-3 text-muted">Email</dt>
                            <dd class="col-sm-9">@Model.Customer.Email</dd>

                            <dt class="col-sm-3 text-muted">Phone</dt>
                            <dd class="col-sm-9">@Model.Customer.Phone</dd>

                            <dt class="col-sm-3 text-muted">Generated</dt>
                            <dd class="col-sm-9">@Model.CreatedOn.ToString("dd MMM yyyy hh:mm tt")</dd>
                        </dl>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card shadow-sm border-0 bg-light h-100">
                    <div class="card-body d-flex flex-column justify-content-center">
                        <p class="text-muted text-uppercase small mb-2">Grand Total</p>
                        <h2 class="display-6 fw-semibold mb-0">₹@Model.GrandTotal.ToString("N2")</h2>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Product</th>
                                <th>Description</th>
                                <th>Quantity</th>
                                <th>Price</th>
                                <th>Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td class="fw-semibold">@item.ProductName</td>
                                    <td class="text-muted">@item.Description</td>
                                    <td>@item.Quantity</td>
                                    <td>₹@item.UnitPrice.ToString("N2")</td>
                                    <td>₹@item.LineTotal.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end mt-3">
            <span class="badge text-bg-primary fs-6 px-3 py-2">Total: ₹@Model.GrandTotal.ToString("N2")</span>
        </div>
    </div>
</div>
