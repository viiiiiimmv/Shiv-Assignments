<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WebApiInAsp.netcoreMvcDemo</title>

    <!-- Bootswatch Theme -->
    <link href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.2/dist/quartz/bootstrap.min.css" rel="stylesheet">

    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <!-- Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebApiInAsp.netcoreMvcDemo.styles.css" asp-append-version="true" />
</head>

<body>

    <!-- HEADER -->
    <header class="bg-primary text-white p-3 d-flex justify-content-between align-items-center">
        <h4 class="m-0">Employee Management Dashboard</h4>

        <div>
            @{
                var username = Context.Session.GetString("username");
            }

            @if (!string.IsNullOrEmpty(username))
            {
                <span class="me-3">
                    Welcome, <strong>@username</strong>
                </span>
                <a href="/AuthenticationUI/Logout" class="btn btn-light btn-sm" id="logoutLink">Logout</a>
            }
        </div>
    </header>

    <!-- MAIN LAYOUT -->
    <div class="container-fluid">
        <div class="row">

            <!-- SIDEBAR -->
            <div class="col-md-3 bg-light p-3 min-vh-100">
                <div class="accordion" id="sidebarAccordion">

                    <div class="accordion-item">
                        <h2 class="accordion-header" id="headingEmp">
                            <button class="accordion-button" type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#collapseEmp"
                                    aria-expanded="true">
                                Employee Management
                            </button>
                        </h2>

                        <div id="collapseEmp" class="accordion-collapse collapse show"
                             data-bs-parent="#sidebarAccordion">

                            <div class="accordion-body p-2">
                                <a href="/EmployeeUI/Index" class="d-block mb-2 text-dark fw-semibold">
                                    📋 Employee Data
                                </a>

                                <a href="/EmployeeUI/Export" class="d-block mb-2 text-dark fw-semibold">
                                    📤 Employee Export
                                </a>
                            </div>

                        </div>
                    </div>

                </div>
            </div>

            <!-- CONTENT -->
            <div class="col-md-9 p-4">
                @RenderBody()
            </div>

        </div>
    </div>

    <!-- FOOTER -->
    <footer class="border-top text-muted text-center py-3">
        <div class="container">
            &copy; 2026 - WebApiInAsp.netcoreMvcDemo |
            <a asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <!-- Bootstrap JS (IMPORTANT) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Site JS -->
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
