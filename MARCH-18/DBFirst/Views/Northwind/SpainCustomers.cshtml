@model dynamic

@{
    ViewData["Title"] = "Spain Customers";
}

<div class="container mt-5">

    <h2 class="mb-1">Customers from Spain</h2>
    <p class="text-muted mb-4">Listing all customers based in Spain.</p>

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-striped table-hover text-center align-middle mb-0">
                <thead class="table-dark">
                <tr>
                    <th>Customer ID</th>
                    <th>Contact Name</th>
                    <th>Company Name</th>
                </tr>
                </thead>
                <tbody>
                @foreach (dynamic c in Model)
                {
                    <tr>
                        <td>@c.cid</td>
                        <td>@c.cname</td>
                        <td>@c.comname</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

</div>