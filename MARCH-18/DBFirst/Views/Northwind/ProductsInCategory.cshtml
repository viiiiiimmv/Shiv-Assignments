@model IEnumerable<DBFirst.Models.ProdCat>
<head>
    <title>Products by Category</title>
</head>
<body class="bg-light">

<div class="container mt-5">

    <!-- Heading -->
    <h2 class="text-center mb-4">Products by Category</h2>

    <!-- Search Form -->
    <div class="card p-4 shadow-sm mb-4">
        <form method="get" asp-controller="Northwind" asp-action="ProductsInCategory">
            <div class="row g-2">
                <div class="col-md-10">
                    <input 
                        type="text" 
                        name="category" 
                        class="form-control" 
                        placeholder="Enter category name..."
                        value="@Context.Request.Query["category"]" />
                </div>
                <div class="col-md-2 d-grid">
                    <button type="submit" class="btn btn-primary">
                        Search
                    </button>
                </div>
            </div>
        </form>
    </div>

    <!-- Table -->
    <div class="card shadow-sm">
        <div class="card-body">

            <table class="table table-striped table-hover text-center align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Product</th>
                        <th>Category</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var res in Model)
                        {
                            <tr>
                                <td>@res.prodName</td>
                                <td>@res.catName</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="2" class="text-muted">No data found</td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>

</div>

</body>