@{
    ViewData["Title"] = "Home Page";
}

<div class="d-flex justify-content-center align-items-center vh-100 bg-light">
    <div class="row g-4 justify-content-center px-4">

        <div class="col-auto">
            <div class="card shadow-sm" style="width: 280px;">
                <div class="card-body text-center p-4">
                    <h5 class="card-title mb-2">Customers by Range</h5>
                    <p class="text-muted small mb-4">View customers filtered by their order count range.</p>
                    <a href="/Northwind/CustomersByRange" class="btn btn-primary w-100">Go Ahead</a>
                </div>
            </div>
        </div>

        <div class="col-auto">
            <div class="card shadow-sm" style="width: 280px;">
                <div class="card-body text-center p-4">
                    <h5 class="card-title mb-2">Products in Category</h5>
                    <p class="text-muted small mb-4">View products ordered by category.</p>
                    <a href="/Northwind/ProductsInCategory" class="btn btn-primary w-100">Go Ahead</a>
                </div>
            </div>
        </div>

        <div class="col-auto">
            <div class="card shadow-sm" style="width: 280px;">
                <div class="card-body text-center p-4">
                    <h5 class="card-title mb-2">Spain Customers</h5>
                    <p class="text-muted small mb-4">View customers hailing from Spain in list and tabular form.</p>
                    <a href="/Northwind/SpainCustomers" class="btn btn-primary w-100">Go Ahead</a>
                </div>
            </div>
        </div>

    </div>
</div>